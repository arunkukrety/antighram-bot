# ==============================================================================
# Antighram Bot Configuration
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Recommended: Comma-separated list of numeric Telegram chat IDs authorized to use the bot.
# Obtain your chat ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"

# Optional: Path to the agy CLI binary (defaults to 'agy')
AGY_BIN="agy"

# Optional: Default workspace directory when no workspace is specified
AGY_DEFAULT_WORKSPACE="~/agy-server-workspace"

# Optional: Maximum seconds before agy print mode times out (default: 300)
AGY_PRINT_TIMEOUT=300

